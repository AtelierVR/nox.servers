{
  "type": "mod",
  "id": "nox.servers",
  "provides": [
    "fr.hactazia.servers",
    "servers"
  ],
  "name": "Servers",
  "version": "1.0.0",
  "description": "Server discovery, listing, and management API for Nox servers.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/nox.servers",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/nox.servers/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "users",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.users.git"
    },
    {
      "id": "network",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.network.git"
    },
    {
      "id": "ui",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.ui.git"
    }
  ],
  "entrypoints": {
    "main": [
      "Nox.Servers.Runtime.Main"
    ],
    "client": [
      "Nox.Servers.Runtime.Client"
    ]
  },
  "constraints": [
    {
      "type": "after",
      "id": "users"
    },
    {
      "type": "after",
      "id": "network"
    },
    {
      "type": "after",
      "id": "ui"
    }
  ]
}
